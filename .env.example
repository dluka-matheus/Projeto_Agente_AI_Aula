# Configuração do Provedor de LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_gemini_aqui
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Configurações do RAG e Vector Store
VECTOR_STORE_DIR=./dados_vetoriais
TOP_K_RETRIEVAL=3

# Persistência de Protocolos
DATABASE_PATH=./protocolos.db

# Configurações do LangGraph
RECURSION_LIMIT=15
